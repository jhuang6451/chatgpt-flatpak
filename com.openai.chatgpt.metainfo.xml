  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>ChatGPT</name>
  <summary>Official ChatGPT Desktop Client by OpenAI</summary>

  <description>
    <p>
      Desktop client for OpenAI's ChatGPT assistant and Codex coding agent, repackaged as a Flatpak.
      This package is not published by OpenAI.
    </p>
    <ul>
      <li>ChatGPT conversations and the Codex agent in a native desktop window</li>
      <li>Wayland and X11 support, with desktop notifications</li>
      <li>Read-write access to the home directory, so Codex can work on local projects</li>
      <li>Updates through a self-hosted Flatpak repository</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.openai.chatgpt.desktop</launchable>

  <url type="homepage">https://developers.openai.com/codex/app</url>
  <url type="help">https://help.openai.com</url>
  <url type="bugtracker">https://github.com/jhuang6451/chatgpt-flatpak/issues</url>
  <url type="vcs-browser">https://github.com/jhuang6451/chatgpt-flatpak</url>

  <developer id="com.openai">
    <name>OpenAI</name>
  </developer>

  <categories>
    <category>Utility</category>
  </categories>

  <provides>
    <binary>chatgpt</binary>
    <mediatype>x-scheme-handler/codex</mediatype>
    <mediatype>x-scheme-handler/chatgpt</mediatype>
  </provides>

